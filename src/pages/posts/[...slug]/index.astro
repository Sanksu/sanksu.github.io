---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { render } from 'astro:content'
import { getVisiblePosts, getAdjacentPosts, postUrl, postDateKey } from '../../../lib/posts'
import { getSiteName, getSiteAuthor, getSiteUrl, walineConfig } from '../../../data/site'
import { formatDate, getReadingTime, slugFromFilename } from '../../../lib/utils'
import WalineComments from '../../../components/WalineComments.astro'
import Pageview from '../../../components/Pageview.astro'
import Toc from '../../../components/Toc.astro'
import PostNav from '../../../components/PostNav.astro'
import CodeBlock from '../../../components/CodeBlock.astro'
import ImagePreview from '../../../components/ImagePreview.astro'
import ReadingProgress from '../../../components/ReadingProgress.astro'

export async function getStaticPaths() {
  const posts = await getVisiblePosts()
  return posts.map(post => {
    const d = post.data.date
    return {
      params: {
        slug: `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}/${slugFromFilename(post.id)}`,
      },
      props: { post },
    }
  })
}

interface Props {
  post: Awaited<ReturnType<typeof getVisiblePosts>>[number]
}

const { post } = Astro.props
const { Content } = await render(post)
const readingTime = getReadingTime(post.body ?? '')
const { prev, next } = await getAdjacentPosts(slugFromFilename(post.id))
const title = `${post.data.title} - ${getSiteName()}`
const postPath = postUrl(post)

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  datePublished: postDateKey(post),
  author: {
    '@type': 'Person',
    name: getSiteAuthor(),
  },
  publisher: {
    '@type': 'Organization',
    name: getSiteName(),
  },
  mainEntityOfPage: `${getSiteUrl()}${postPath}`,
  ...(post.data.categories.length > 0 ? { articleSection: post.data.categories[0] } : {}),
})
---

<BaseLayout title={title}>
  <script slot="head" type="application/ld+json" set:html={articleSchema} />
  <ReadingProgress />
  <div class="ek-post-layout">
    <article class="ek-post">
      {post.data.cover && (
        <div class="ek-post-cover">
          <img src={post.data.cover} alt={`${post.data.title} 封面`} loading="eager" />
        </div>
      )}
      <h1 class="ek-post-head__title">
        {post.data.title}
      </h1>

      {/* 任务状态条 */}
      <div class="ek-post-meta">
        <span class="ek-post-meta__cell">
          <span class="ek-post-meta__label">OPERATOR</span>
          <span class="ek-post-meta__value">{getSiteAuthor()}</span>
        </span>
        <span class="ek-post-meta__cell">
          <span class="ek-post-meta__label">DATE</span>
          <span class="ek-post-meta__value">{formatDate(postDateKey(post))}</span>
        </span>
        <span class="ek-post-meta__cell">
          <span class="ek-post-meta__label">READ</span>
          <span class="ek-post-meta__value">{readingTime} MIN</span>
        </span>
        <span class="ek-post-meta__cell">
          <span class="ek-post-meta__label">VIEWS</span>
          <span class="ek-post-meta__value"><Pageview serverURL={walineConfig.serverURL} path={postPath} /></span>
        </span>
        {post.data.categories.length > 0 && (
          <span class="ek-post-meta__cell">
            <span class="ek-post-meta__label">CATEGORY</span>
            <span class="ek-post-meta__value">
              {post.data.categories.map(cat => (
                <a class="ek-chip" href={`/categories/#${encodeURIComponent(cat)}`}>{cat}</a>
              ))}
            </span>
          </span>
        )}
      </div>

      <div class="ek-prose">
        <Content />
      </div>
      <CodeBlock />
      <PostNav prevPost={prev} nextPost={next} />
      <WalineComments serverURL={walineConfig.serverURL} path={postPath} />
    </article>
    <Toc content={post.body} />
  </div>
  <ImagePreview />
</BaseLayout>
