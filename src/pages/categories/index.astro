---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCategories, postUrl, postDateKey } from '../../lib/posts'
import { formatDate } from '../../lib/utils'
import Reveal from '../../components/Reveal.astro'

const categories = await getCategories()
const sorted = Object.entries(categories).sort((a, b) => a[0].localeCompare(b[0]))
---

<BaseLayout title="分类 - Sanksu Blog" description="按分类浏览 Sanksu Blog 的所有文章">
  <div class="ek-stage">
    <Reveal />
    <div class="ek-section-title ek-reveal">
      <h1 class="ek-section-title__text">分类 / CATEGORIES</h1>
      <span class="ek-section-title__meta">{sorted.length} 类</span>
    </div>
    <div class="ek-cloud ek-reveal">
      {sorted.map(([cat]) => (
        <a href={`#${cat}`}>{cat}</a>
      ))}
    </div>
    {sorted.map(([cat, posts], i) => (
      <section id={cat}>
        <div class="ek-section-title ek-reveal">
          <span class="ek-section-title__index">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="ek-section-title__text">{cat}</h2>
          <span class="ek-section-title__meta"><span class="ek-tag-count">({posts.length})</span></span>
        </div>
        <ul class="ek-list">
          {posts.map((post, j) => (
            <li class="ek-list__item ek-reveal" style={`transition-delay:${j * 60}ms`}>
              <span class="ek-list__date">{formatDate(postDateKey(post))}</span>
              <span class="ek-list__title"><a href={postUrl(post)}>{post.data.title}</a></span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
