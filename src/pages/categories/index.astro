---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCategories, postUrl, postDateKey } from '../../lib/posts'
import { formatDate } from '../../lib/utils'

const categories = await getCategories()
const sorted = Object.entries(categories).sort((a, b) => a[0].localeCompare(b[0]))
---

<BaseLayout title="分类 - Sanksu Blog" description="按分类浏览 Sanksu Blog 的所有文章">
  <div class="page page-categories">
    <div class="list-category">
      <h2>所有分类</h2>
      <div>
        {sorted.map(([cat]) => (
          <a href={`#${cat}`}>{cat}</a>
        ))}
      </div>
    </div>
    {sorted.map(([cat, posts]) => (
      <section class="list-post">
        <h2 id={cat}>{cat}<span class="tag-count">({posts.length})</span></h2>
        <ul>
          {posts.map(post => (
            <li>
              <span class="date">{formatDate(postDateKey(post))}</span>
              <span class="title"><a href={postUrl(post)}>{post.data.title}</a></span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
