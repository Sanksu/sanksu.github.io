---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPostsByYear, postUrl, postDateKey } from '../lib/posts'
import { formatDate } from '../lib/utils'
import { siteMetadata } from '../data/site'
import Reveal from '../components/Reveal.astro'

const postsByYear = await getPostsByYear()
const years = Object.entries(postsByYear).sort((a, b) => Number(b[0]) - Number(a[0]))

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sanksu Blog',
  url: siteMetadata.site.url,
  description: siteMetadata.site.description,
})

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sanksu',
  url: siteMetadata.site.url,
  sameAs: [
    'https://github.com/sanksu',
    'https://space.bilibili.com/219597773',
  ],
})
---

<BaseLayout title="首页 - Sanksu Blog" description={siteMetadata.site.description}>
  <script slot="head" type="application/ld+json" set:html={websiteSchema} />
  <script slot="head" type="application/ld+json" set:html={personSchema} />
  <h1 class="sr-only">Sanksu Blog</h1>
  <div class="ek-stage">
    <Reveal />
    {years.map(([year, posts], i) => (
      <section class="ek-section" id={year}>
        <div class="ek-section-title ek-reveal">
          <span class="ek-section-title__index">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="ek-section-title__text">{year} / FIELD LOG</h2>
          <span class="ek-section-title__meta">REC-{year} · {posts.length} 篇</span>
        </div>
        <ul class="ek-list">
          {posts.map((post, j) => (
            <li class="ek-list__item ek-reveal" style={`transition-delay:${j * 60}ms`}>
              <span class="ek-list__date">{formatDate(postDateKey(post))}</span>
              <span class="ek-list__title">
                <a href={postUrl(post)}>{post.data.title}</a>
              </span>
              <span class="ek-list__cats">
                {post.data.categories.map(cat => (
                  <a class="ek-chip" href={`/categories/#${encodeURIComponent(cat)}`}>{cat}</a>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
