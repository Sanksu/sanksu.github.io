---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getTags, postUrl, postDateKey } from '../../lib/posts'
import { formatDate } from '../../lib/utils'

const tags = await getTags()
const sorted = Object.entries(tags).sort((a, b) => a[0].localeCompare(b[0]))
---

<BaseLayout title="标签 - Sanksu Blog" description="按标签浏览 Sanksu Blog 的所有文章">
  <div class="page page-tags">
    <div class="list-tag">
      <h2>所有标签</h2>
      <div class="tag-cloud">
        {sorted.map(([tag]) => (
          <a href={`#${tag}`}>{tag}</a>
        ))}
      </div>
    </div>
    {sorted.map(([tag, posts]) => (
      <section class="list-post">
        <h2 id={tag}><span class="tag-label">{tag}</span><span class="tag-count">({posts.length})</span></h2>
        <ul>
          {posts.map(post => (
            <li>
              <span class="date">{formatDate(postDateKey(post))}</span>
              <span class="title"><a href={postUrl(post)}>{post.data.title}</a></span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
