---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getTags, postUrl, postDateKey } from '../../lib/posts'
import { formatDate } from '../../lib/utils'
import Reveal from '../../components/Reveal.astro'

const tags = await getTags()
const sorted = Object.entries(tags).sort((a, b) => a[0].localeCompare(b[0]))
---

<BaseLayout title="标签 - Sanksu Blog" description="按标签浏览 Sanksu Blog 的所有文章">
  <div class="ek-stage">
    <Reveal />
    <div class="ek-section-title ek-reveal">
      <span class="ek-section-title__text">标签 / TAGS</span>
      <span class="ek-section-title__meta">{sorted.length} 个</span>
    </div>
    <div class="ek-cloud ek-reveal">
      {sorted.map(([tag]) => (
        <a href={`#${tag}`}>{tag}</a>
      ))}
    </div>
    {sorted.map(([tag, posts], i) => (
      <section id={tag}>
        <div class="ek-section-title ek-reveal">
          <span class="ek-section-title__index">{String(i + 1).padStart(2, '0')}</span>
          <span class="ek-section-title__text">{tag}</span>
          <span class="ek-section-title__meta"><span class="ek-tag-count">({posts.length})</span></span>
        </div>
        <ul class="ek-list">
          {posts.map((post, j) => (
            <li class="ek-list__item ek-reveal" style={`transition-delay:${j * 60}ms`}>
              <span class="ek-list__date">{formatDate(postDateKey(post))}</span>
              <span class="ek-list__title"><a href={postUrl(post)}>{post.data.title}</a></span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
