---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection, render } from 'astro:content'
import { timeline, projects, socials } from '../../data/about'
import { getVisiblePosts } from '../../lib/posts'
import { stripMarkdown } from '../../lib/utils'
import Reveal from '../../components/Reveal.astro'

const posts = await getVisiblePosts()
const [bio] = await getCollection('about')
const { Content } = bio ? await render(bio) : { Content: () => null }
const totalPosts = posts.length
const totalCategories = new Set(posts.flatMap(p => p.data.categories)).size
const totalTags = new Set(posts.flatMap(p => p.data.tags)).size
const totalChars = posts.reduce((acc, p) => acc + stripMarkdown(p.body ?? '').length, 0)
const totalReadingMin = posts.reduce((acc, p) => acc + Math.max(1, Math.ceil(stripMarkdown(p.body ?? '').length / 300)), 0)
const startDate = new Date('2020-04-01')
const daysRunning = Math.floor((Date.now() - startDate.getTime()) / (1000 * 60 * 60 * 24))

const stats = [
  [String(totalPosts), '文章 / POSTS'],
  [totalChars.toLocaleString(), '总字数 / CHARS'],
  [String(totalCategories), '分类 / CATS'],
  [String(totalTags), '标签 / TAGS'],
  [String(totalReadingMin), '阅读分钟 / MINS'],
  [String(daysRunning), '建站天数 / DAYS'],
]
---

<BaseLayout title="关于 - Sanksu Blog" description="了解 Sanksu 的经历与项目">
  <div class="ek-stage">
    <Reveal />
    <article class="ek-post">
      <h1 class="ek-post-head__title">关于 / OPERATOR</h1>

      <div class="ek-post-meta ek-reveal">
        <span class="ek-post-meta__cell">
          <span class="ek-post-meta__label">IDENTITY</span>
          <span class="ek-post-meta__value">SANKSU</span>
        </span>
        <span class="ek-post-meta__cell">
          <span class="ek-post-meta__label">STATION</span>
          <span class="ek-post-meta__value">FIELD LOG / 01</span>
        </span>
        <span class="ek-post-meta__cell">
          <span class="ek-post-meta__label">SECTOR</span>
          <span class="ek-post-meta__value">TECH / HARDWARE</span>
        </span>
      </div>

      <div class="ek-prose">
        <blockquote class="ek-bio ek-reveal">
          {bio && (
            <>
              {bio.data.tagline && <p class="ek-bio__tagline">{bio.data.tagline}</p>}
              <Content />
            </>
          )}
        </blockquote>

        <h2>博客统计 / STATS</h2>
        <div class="ek-stats">
          {stats.map((s) => (
            <div class="ek-stat ek-reveal">
              <span class="ek-stat__value">{s[0]}</span>
              <span class="ek-stat__label">{s[1]}</span>
            </div>
          ))}
        </div>

        <h2>经历 / TIMELINE</h2>
        <div class="ek-timeline">
          {timeline.map(item => (
            <div class="ek-timeline__item">
              <span class="ek-timeline__year">{item.year}</span>
              <div class="ek-timeline__content">
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
                {(item.url || item.link) && (
                  <a href={(item.url || item.link)} target="_blank" rel="noopener noreferrer" class="ek-timeline__link">查看详情 &rarr;</a>
                )}
              </div>
            </div>
          ))}
        </div>

        <h2>项目作品集 / PROJECTS</h2>
        <div class="ek-projects">
          {projects.map(project => (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="ek-project">
              <h3>{project.name}</h3>
              <p>{project.desc}</p>
              <div class="ek-project__tags">
                {project.tags.map(tag => (
                  <span class="ek-project__tag">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>

        <h2>联系我 / CONTACT</h2>
        <div class="ek-socials">
          {socials.map(s => (
            <a
              href={s.url}
              target={s.platform === 'email' ? undefined : '_blank'}
              rel={s.platform === 'email' ? undefined : 'noopener noreferrer'}
              class="ek-social"
            >
              <span class="ek-social__label">{s.label}</span>
              <span class="ek-social__url">{s.url.replace(/^mailto:|^https?:\/\//, '')}</span>
            </a>
          ))}
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
