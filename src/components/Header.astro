---
const NAV_LINKS = [
  { href: '/', label: '首页', en: 'INDEX', index: '01' },
  { href: '/categories/', label: '分类', en: 'CATEGORIES', index: '02' },
  { href: '/tags/', label: '标签', en: 'TAGS', index: '03' },
  { href: '/archive/', label: '归档', en: 'ARCHIVE', index: '04' },
  { href: '/search/', label: '搜索', en: 'SEARCH', index: '05' },
  { href: '/about/', label: '关于', en: 'ABOUT', index: '06' },
] as const

const { pathname } = Astro.url

function isActive(href: string): boolean {
  if (href === '/') {
    return pathname === '/' || pathname === '/index/'
  }
  return pathname === href || pathname.startsWith(href)
}

const activeIndex = NAV_LINKS.find(l => isActive(l.href))?.index ?? '01'
---

<!-- 顶部炭黑 dock -->
<header class="ek-topbar">
  <div class="ek-topbar__brand">
    <a href="/" class="ek-brand" aria-label="返回首页">
      <span class="ek-brand__mark" aria-hidden="true"></span>
      <span class="ek-brand__text">
        <strong>SANKSU</strong>
        <small>FIELD LOG</small>
      </span>
    </a>
  </div>
  <div class="ek-topbar__status">
    <span class="ek-status-dot" aria-hidden="true"></span>
    <span class="ek-status-text">SYS / ONLINE</span>
  </div>
  <span class="ek-topbar__wedge" aria-hidden="true"></span>
</header>

<!-- 侧栏 pale rail -->
<div class="ek-rail-wrap">
  <nav class="ek-rail" aria-label="主导航">
    {NAV_LINKS.map((link) => {
      const active = isActive(link.href)
      return (
        <a
          href={link.href}
          class:list={['ek-rail__item', { 'is-active': active }]}
          aria-current={active ? 'page' : undefined}
        >
          <span class="ek-rail__index">{link.index}</span>
          <span class="ek-rail__label">
            <span class="ek-rail__label-cn">{link.label}</span>
            <span class="ek-rail__label-en">{link.en}</span>
          </span>
          <span class="ek-rail__bar" aria-hidden="true"></span>
        </a>
      )
    })}
    <span class="ek-rail__foot">
      <span class="ek-rail__foot-code">SYS-{activeIndex}</span>
      <button class="ek-rail__theme" data-action="toggle-theme" title="切换主题" aria-label="切换主题">
        <span data-theme-icon></span>
      </button>
    </span>
  </nav>
</div>

<script>
  // 亮/暗主题切换（按钮位于导航栏 SYS 码旁）
  const root = document.documentElement

  function currentDark(): boolean {
    return root.classList.contains('dark')
  }

  function renderIcon(isDark: boolean) {
    document.querySelectorAll('[data-theme-icon]').forEach(el => {
      el.textContent = isDark ? '\u2600' : '\u263E'
    })
  }

  function applyTheme(isDark: boolean) {
    root.classList.toggle('dark', isDark)
    localStorage.setItem('darkMode', String(isDark))
    renderIcon(isDark)
  }

  document.querySelectorAll('[data-action="toggle-theme"]').forEach(btn => {
    btn.addEventListener('click', () => applyTheme(!currentDark()))
  })

  renderIcon(currentDark())
</script>
